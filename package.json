  },
  "files": [
    "scoring.mjs",
    "rubric.json",
    "schemas/assessment-input.schema.json",
    "schemas/rubric-config.schema.json",
    "schemas/score-result.schema.json",
    "proposals/README.md",
    "proposals/0003.md",
    "test/vectors.json",
    "test/input-semantics.json",
    "test/scoring.test.mjs",
    "test/input-semantics.test.mjs",
    "test/schema-contract.test.mjs",
    "test/package.test.mjs",
    "RUBRIC.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "CANDIDATE.json",
    "NOTICE"
  ],
  "scripts": {
    "test": "node --test \"test/**/*.mjs\""
  }
