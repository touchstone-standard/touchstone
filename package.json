{
  "name": "@touchstonestandard/rubric",
  "version": "0.3.0",
  "license": "Apache-2.0",
  "type": "module",
  "description": "Touchstone 0.3: card-condition rubric, schemas and dependency-free reference scorer.",
  "main": "./scoring.mjs",
  "exports": {
    ".": "./scoring.mjs",
